#!/bin/sh
# Fake yt-dlp for tests. Reads fixtures from tests/fixtures/ytdlp/.
#   --version                        prints a version
#   --flat-playlist -J ... <url>     prints playlists/<list id>.json
#   -J ... <watch url>               prints videos/<id>.info.json (or a generated one)
#   subtitles only (--skip-download): writes media.<lang>.vtt into the -o directory.
#   download (--print after_move:filepath): writes media.mkv and ytdlp.info.json
#     into the -o directory, plus media.en.vtt with --write-subs.
# videos/<id>.error makes a video fail with that message (exit 1).
# TIDEPOOL_FAKE_YTDLP_LOG: append each call's arguments to this file.
# TIDEPOOL_FAKE_YTDLP_SLEEP: seconds to wait before finishing a download.
# TIDEPOOL_FAKE_THUMB_BASE: replaces https://i.ytimg.com in info JSON.
# TIDEPOOL_FAKE_YTDLP_FAIL: every download and -J lookup fails with this message.
# TIDEPOOL_FAKE_MEDIA: a real media file to copy instead of writing fake bytes.
fixtures="$(cd "$(dirname "$0")/.." && pwd)/fixtures/ytdlp"
[ -n "${TIDEPOOL_FAKE_YTDLP_LOG:-}" ] && echo "$*" >> "$TIDEPOOL_FAKE_YTDLP_LOG"

for arg; do last="$arg"; done

info() { # print the info JSON for a video id
  if [ -f "$fixtures/videos/$1.info.json" ]; then
    sed "s#https://i.ytimg.com#${TIDEPOOL_FAKE_THUMB_BASE:-https://i.ytimg.com}#g" "$fixtures/videos/$1.info.json"
  else
    printf '{"id":"%s","title":"Video %s","channel":"Lofi Girl","channel_id":"UCSJ4gkVC6NrvII8umztf0Ow","upload_date":"20260901","timestamp":1788220800,"duration":300,"description":"About %s","tags":["lofi"],"thumbnails":[]}\n' "$1" "$1" "$1"
  fi
}
fail_if_error() {
  if [ -n "${TIDEPOOL_FAKE_YTDLP_FAIL:-}" ]; then echo "$TIDEPOOL_FAKE_YTDLP_FAIL" >&2; exit 1; fi
  if [ -f "$fixtures/videos/$1.error" ]; then cat "$fixtures/videos/$1.error" >&2; exit 1; fi
}

case " $* " in
  *" --version "*) echo 2026.10.01; exit 0 ;;
  *" --flat-playlist "*)
    id="${last##*list=}"; id="${id%%&*}"
    if [ -f "$fixtures/playlists/$id.json" ]; then cat "$fixtures/playlists/$id.json"; exit 0; fi
    echo "ERROR: [youtube:tab] $id: The playlist does not exist." >&2
    exit 1 ;;
  *" after_move:filepath "*)
    id="${last##*v=}"
    fail_if_error "$id"
    media=""; infojson=""; prev=""
    for arg; do
      if [ "$prev" = "-o" ]; then
        case "$arg" in infojson:*) infojson="${arg#infojson:}" ;; *) media="$arg" ;; esac
      fi
      prev="$arg"
    done
    dir="$(dirname "$media")"
    mkdir -p "$dir"
    echo '{"status": "downloading", "downloaded_bytes": 10, "total_bytes": 20}'
    [ -n "${TIDEPOOL_FAKE_YTDLP_SLEEP:-}" ] && sleep "$TIDEPOOL_FAKE_YTDLP_SLEEP"
    if [ -n "${TIDEPOOL_FAKE_MEDIA:-}" ]; then
      cp "$TIDEPOOL_FAKE_MEDIA" "$dir/media.mkv"
    else
      printf 'fake media for %s\n' "$id" > "$dir/media.mkv"
    fi
    info "$id" > "$infojson.info.json"
    case " $* " in *" --write-subs "*) printf 'WEBVTT\n\n00:00.000 --> 00:00.500\nHello\n' > "$dir/media.en.vtt" ;; esac
    echo '{"status": "finished", "downloaded_bytes": 20, "total_bytes": 20}'
    echo "$dir/media.mkv"
    exit 0 ;;
  *" --skip-download "*)
    # Subtitles only: media.<lang>.vtt for the --sub-langs language.
    id="${last##*v=}"
    fail_if_error "$id"
    media=""; lang=""; prev=""
    for arg; do
      [ "$prev" = "-o" ] && media="$arg"
      [ "$prev" = "--sub-langs" ] && lang="$arg"
      prev="$arg"
    done
    dir="$(dirname "$media")"
    mkdir -p "$dir"
    printf 'WEBVTT\n\n00:00.000 --> 00:00.500\nRestored\n' > "$dir/media.$lang.vtt"
    exit 0 ;;
  *" -J "*)
    id="${last##*v=}"
    fail_if_error "$id"
    info "$id"
    exit 0 ;;
esac
echo "fake yt-dlp: unsupported arguments: $*" >&2
exit 2
